# LLM Provider
# Supported: gemini, groq, ollama / openai_compatible
REPOAGENT_PROVIDER=groq
REPOAGENT_MODEL=openai/gpt-oss-20b
REPOAGENT_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
REPOAGENT_MAX_RPM=4

# OpenAI / Ollama Alternative
# REPOAGENT_PROVIDER=ollama
# REPOAGENT_MODEL=qwen2.5-coder:3b
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=

# Gemini Alternative
# REPOAGENT_PROVIDER=gemini
# REPOAGENT_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Docker Sandbox
SANDBOX_IMAGE=repoagent-sandbox:latest
SANDBOX_TIMEOUT_S=120
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
